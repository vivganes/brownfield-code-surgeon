{
  "name": "@brownfield-surgeon/core-prompts",
  "version": "0.1.0",
  "private": true,
  "description": "Source-of-truth agent prompts for the seven-phase brownfield surgery workflow, ported from ampyard/brownfield-agentic-code-surgery.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prompts/*": "./prompts/*"
  },
  "files": ["dist", "prompts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@brownfield-surgeon/shared": "*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
