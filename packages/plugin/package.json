{
  "name": "@brownfield-surgeon/plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin for the brownfield code surgeon: seven subagents, slash commands, and phase-aware hooks.",
  "license": "MIT",
  "type": "module",
  "files": [
    ".claude-plugin",
    "agents",
    "commands",
    "hooks",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node dist/build/postbuild.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist agents && node -e \"require('fs').readdirSync('hooks').filter(f=>f.endsWith('.js')).forEach(f=>require('fs').unlinkSync('hooks/'+f))\" && node -e \"require('fs').existsSync('scripts')&&require('fs').readdirSync('scripts').filter(f=>f.endsWith('.js')).forEach(f=>require('fs').unlinkSync('scripts/'+f))\""
  },
  "dependencies": {
    "@brownfield-surgeon/shared": "*",
    "@brownfield-surgeon/core-prompts": "*"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
