{
  "name": "@brownfield-surgeon/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Operating-theater web UI: immersive 3D scene with patient, monitors, and instrument tray.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "toy-test": "concurrently -n toy,server,web -c yellow,blue,magenta \"npm:toy-test:backend\" \"npm:toy-test:server\" \"npm:dev:web\"",
    "toy-test:auto-approve": "concurrently -n toy,server,web -c yellow,blue,magenta \"npm:toy-test:backend:auto-approve\" \"npm:toy-test:server\" \"npm:dev:web\"",
    "toy-test:backend": "tsx server/toy-backend.ts",
    "toy-test:backend:auto-approve": "tsx server/toy-backend.ts --auto-approve",
    "toy-test:server": "tsx server/toy-test-server.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@brownfield-surgeon/managed-runner": "*",
    "@brownfield-surgeon/shared": "*",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^15.0.6",
    "@testing-library/user-event": "^14.5.2",
    "@testing-library/dom": "^9.3.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^2.1.0",
    "concurrently": "^9.1.0",
    "jsdom": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.0"
  }
}
