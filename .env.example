# Anthropic API Key for the managed runner
# Set this to your Anthropic API key (starting with sk-...)
# Used by the brownfield-code-surgeon managed runner to interact with Claude
SURGERY_ANTHROPIC_API_KEY=sk-your-key-here

# Optional: GitHub token for cloning and pushing from the cloud container
# If not set here, can be configured through the UI settings dialog
# SURGERY_GIT_TOKEN=ghp_...

# Optional: Anthropic Managed-Agents environment ID
# If not set here, can be configured through the UI settings dialog
# ANTHROPIC_AGENT_ENV_ID=env_...
